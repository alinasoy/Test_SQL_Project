# Copy this file to  .streamlit/secrets.toml  and fill in your real values.
# Never share secrets.toml or upload it to GitHub.

LLM_PROVIDER   = "gemini"          # gemini | groq | openai
GOOGLE_API_KEY = "paste-your-gemini-key-here"
# GROQ_API_KEY   = "paste-your-groq-key-here"      # optional backup provider
# OPENAI_API_KEY = ""

# Optional: saved MySQL / PostgreSQL connection (leave out if you don't need it)
# DB_HOST     = "localhost"
# DB_PORT     = "3306"
# DB_USER     = "reader"
# DB_PASSWORD = "your-db-password"
# DB_NAME     = "sales_demo"

# Optional: require a password to open the app
# APP_PASSWORD = "choose-a-password"
